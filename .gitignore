# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.claude
~$leForge-Tools.docx
CLAUDE.md
FileForge-Tools.docx

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Vendored runtime assets — copied from node_modules by scripts/copy-vendor-assets.mjs
/public/ffmpeg
/public/pdfjs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds no secrets and is the only record
# of which variables the build reads.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
