# Copy to .env.local and fill in. Everything here is optional — unset values
# simply disable the feature rather than breaking the build.
#
# IMPORTANT: these are NEXT_PUBLIC_* vars in a statically exported site, so
# they are baked in at BUILD time, not read at runtime. Changing any of them
# means running `npm run build` again and redeploying.

# ─── Site ───────────────────────────────────────────────────────────────────
# Canonical origin. Drives canonical tags, sitemap.xml, robots.txt and all
# structured data URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── AdSense ────────────────────────────────────────────────────────────────
# Your AdSense publisher ID. Until this is set, ad slots render labelled
# placeholder boxes instead of real units.
#
# NOTE: this must be AdSense, not AdMob. AdMob only serves ads inside native
# Android/iOS apps and cannot be used on a website. They are separate products
# under the same Google account.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# One ad unit ID per placement, created in the AdSense dashboard.
# NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_INFEED=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=XXXXXXXXXX

# ─── Analytics ──────────────────────────────────────────────────────────────
# GA4 measurement ID. Only loads after the visitor accepts the consent banner.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
